# Skyline configuration reference. PLACEHOLDERS ONLY — never put real values in this file.
# Secrets are passed as files (the *_FILE variables). docker compose generates them for you
# with the secrets-init service, so you do not need a .env file to run locally.

SKYLINE_ENV=development                 # development | production | test
SKYLINE_LOG_LEVEL=info
SKYLINE_PUBLIC_ORIGIN=http://localhost:3000

SKYLINE_DB_HOST=localhost
SKYLINE_DB_PORT=5432
SKYLINE_DB_NAME=skyline
SKYLINE_DB_USER=skyline_api             # skyline_api | skyline_worker | skyline_owner (migrate)
SKYLINE_DB_PASSWORD_FILE=/path/to/db_password
SKYLINE_DB_SSLMODE=disable              # require/verify-full in production

SKYLINE_KEY_PROVIDER=local
SKYLINE_LOCAL_KEK_FILE=/path/to/local_kek.json
SKYLINE_SESSION_KEY_FILE=/path/to/session_key   # api only: HMAC key for CSRF tokens and throttling

SKYLINE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com # migrate only
SKYLINE_BOOTSTRAP_ADMIN_PASSWORD_FILE=/path/to/bootstrap_admin_password
